data/fx/
data/itch/
research/.fxbillions_ckpt.npz
research/.megatick_ckpt.json
data/tick/cache/

# fusion feature matrices (regenerated from tape by fusion_ceiling.py)
data/tick/fusecache/
data/tick/cache/tape_meta.json
