# Tick data (large files, store locally only)
data/tick/

# Backtest-derived caches (regenerated from data/tick/ on demand)
research/bars_*.parquet

# Strategy search runtime checkpoints (binary; regenerated on each run)
research/round*_checkpoint.pkl*

# Multi-account runtime state — each account's data dir is initialised
# on first bot boot in production; never check in local smoke-test state.
data/account_*/

# Runtime supervisor artifacts (regenerated on each run)
research/round*.err
research/round*_supervisor.pid

# Large cross-asset bars (live in the xasset-1m GitHub release, not git)
data/xasset/

# volume bars (large, rebuildable from data/tick/raw)
data/tick/nq_bars_1m_vol.parquet
data/tick/minute_volfeat.parquet
data/tick/quotes_1s.npz
